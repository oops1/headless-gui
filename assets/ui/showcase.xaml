<?xml version="1.0" encoding="UTF-8"?>
<!--
    GuiEngine — Widget Showcase
    Демонстрация ВСЕХ доступных виджетов движка.
    WPF-совместимый XAML.

    Корень — <Window>: настоящий заголовок окна с кнопками ✕ ─ □,
    перетаскиванием за тайтлбар и ресайзом (chrome рисует движок,
    оформление следует выбранной теме — Win10/Win11/Win2000/Mac).
-->
<Window Name="rootWin" Title="GuiEngine — Widget Showcase" Width="1282" Height="934"
        MinWidth="900" MinHeight="600"
        ResizeMode="CanResize" Background="#0D0D1A">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

<Canvas Name="root" Width="1280" Height="900" Background="#0D0D1A">

    <!-- Ресурсы для вкладки «3.2.4» (новый функционал) -->
    <Canvas.Resources>
        <SolidColorBrush x:Key="Accent324" Color="#0E639C"/>
        <Style x:Key="H324" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Status324" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6E3A1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                    <Setter Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="Card324">
            <Border Background="{TemplateBinding Background}" BorderBrush="#5A5A6A" BorderThickness="1">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </Canvas.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Шапка тянется на всю ширину (Left+Right=0). Левый заголовок — внутри
         панели; правые элементы (тема/язык/часы) вынесены прямыми детьми Canvas
         и прижаты к правому краю (Right-инсеты) — панель не пересчитывает своих
         детей при resize, а Canvas пересчитывает. -->
    <Panel Name="header" Left="0" Top="0" Right="0" Height="52"
           Background="#0078D4">
        <Label Name="headerTitle" Left="20" Top="14" Width="500" Height="24"
               Text="GuiEngine — Widget Showcase" Foreground="White"/>
    </Panel>
    <ComboBox Name="themeSelect" Right="355" Top="10" Width="235" Height="32"
              Items="Win10 Dark,Win10 Light,Win11 Dark,Win11 Light,Win2000,Mac"
              SelectedIndex="0" ToolTip="{Loc Switch the theme}"/>
    <Button Name="langToggle" Right="220" Top="10" Width="120" Height="32"
            Content="{Loc Language: RU}" Background="#005A9E" Foreground="White"
            HoverBG="#1A8CFF" PressedBG="#004578" BorderBrush="#1A8CFF"
            ToolTip="{Loc Switch UI language / Переключить язык интерфейса}"/>
    <Label Name="headerClock" Right="10" Top="14" Width="180" Height="24"
           Text="00:00:00" Foreground="#B0D4FF"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MENU BAR — горизонтальное меню
         ═══════════════════════════════════════════════════════════════════════ -->
    <Menu Name="mainMenu" Left="0" Top="52" Right="0" Height="28">
        <MenuItem Header="{Loc File}">
            <MenuItem Text="{Loc New}"/>
            <MenuItem Text="{Loc Open}"/>
            <MenuItem Text="{Loc Save}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Export...}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Exit}"/>
        </MenuItem>
        <MenuItem Header="{Loc Edit}">
            <MenuItem Text="{Loc Undo}"/>
            <MenuItem Text="{Loc Retry}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Cut}"/>
            <MenuItem Text="{Loc Copy}"/>
            <MenuItem Text="{Loc Paste}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Select all}"/>
        </MenuItem>
        <MenuItem Header="{Loc View}">
            <MenuItem Text="{Loc Toolbox}"/>
            <MenuItem Text="{Loc Status bar}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Scale 100%}"/>
            <MenuItem Text="{Loc Scale 150%}"/>
        </MenuItem>
        <MenuItem Header="{Loc Connection}">
            <MenuItem Text="{Loc New connection}"/>
            <MenuItem Text="{Loc Quick connect}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc Disable}"/>
        </MenuItem>
        <MenuItem Header="{Loc Help}">
            <MenuItem Text="{Loc Documentation}"/>
            <MenuItem Text="{Loc Shortcuts}"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="{Loc About}"/>
        </MenuItem>
    </Menu>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SIDEBAR — навигация
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Левая панель: фикс. ширина 220, тянется вниз до статус-бара (Top+Bottom). -->
    <Panel Name="sidebar" Left="0" Top="80" Width="220" Bottom="36"
           Background="#16162B">
        <Label Left="16" Top="16" Width="188" Height="20"
               Text="{Loc WIDGETS}" Foreground="#5B6078"/>
        <Separator Left="16" Top="42" Width="188" Height="1" Background="#2A2A44"/>

        <Label Left="16" Top="56" Width="188" Height="22"
               Text="{Loc Input data}" Foreground="#CDD6F4"/>
        <Label Left="16" Top="84" Width="188" Height="22"
               Text="{Loc Control elements}" Foreground="#CDD6F4"/>
        <Label Left="16" Top="112" Width="188" Height="22"
               Text="{Loc Indicators}" Foreground="#CDD6F4"/>
        <Label Left="16" Top="140" Width="188" Height="22"
               Text="{Loc Containers}" Foreground="#CDD6F4"/>
        <Label Left="16" Top="168" Width="188" Height="22"
               Text="{Loc Lists}" Foreground="#CDD6F4"/>

        <Separator Left="16" Top="206" Width="188" Height="1" Background="#2A2A44"/>

        <Label Left="16" Top="222" Width="188" Height="20"
               Text="{Loc INFORMATION}" Foreground="#5B6078"/>
        <Label Name="sideInfo1" Left="16" Top="248" Width="188" Height="20"
               Text="{Loc Widgets: 16}" Foreground="#7F849C"/>
        <Label Name="sideInfo2" Left="16" Top="272" Width="188" Height="20"
               Text="XAML: showcase.xaml" Foreground="#7F849C"/>
        <Label Name="sideInfo3" Left="16" Top="296" Width="188" Height="20"
               Text="{Loc Resolution: 1280×900}" Foreground="#7F849C"/>
    </Panel>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT — TabControl
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Центральная область вкладок: тянется вправо и вниз (инсеты справа/снизу). -->
    <TabControl Name="mainTabs" Left="220" Top="80" Right="0" Bottom="36"
                SelectedIndex="0">

        <!-- ─── TAB 1: Ввод данных ──────────────────────────────────────── -->
        <TabItem Header="{Loc Input}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">

                <!-- Секция: TextBox / TextInput -->
                <Label Left="30" Top="20" Width="200" Height="20"
                       Text="TextBox" Foreground="#89B4FA"/>
                <Separator Left="30" Top="44" Width="460" Height="1" Background="#313244"/>

                <Label Left="30" Top="56" Width="120" Height="20"
                       Text="{Loc Login:}" Foreground="#BAC2DE"/>
                <TextBox Name="txtLogin" Left="30" Top="78" Width="460" Height="36"
                         Placeholder="user@example.com"/>

                <Label Left="30" Top="126" Width="120" Height="20"
                       Text="{Loc Password:}" Foreground="#BAC2DE"/>
                <PasswordBox Name="txtPassword" Left="30" Top="148" Width="460" Height="36"
                             Placeholder="{Loc Enter the password...}"/>

                <Label Left="30" Top="196" Width="120" Height="20"
                       Text="{Loc Comment:}" Foreground="#BAC2DE"/>
                <TextBox Name="txtComment" Left="30" Top="218" Width="460" Height="36"
                         Placeholder="{Loc Any text to try the input...}"/>

                <!-- Секция: ComboBox / Dropdown -->
                <Label Left="30" Top="280" Width="200" Height="20"
                       Text="ComboBox" Foreground="#89B4FA"/>
                <Separator Left="30" Top="304" Width="460" Height="1" Background="#313244"/>

                <Label Left="30" Top="316" Width="140" Height="20"
                       Text="{Loc User role:}" Foreground="#BAC2DE"/>
                <ComboBox Name="ddRole" Left="30" Top="338" Width="460" Height="32">
                    <ComboBoxItem Content="{Loc Administrator}"/>
                    <ComboBoxItem Content="{Loc Operator}"/>
                    <ComboBoxItem Content="{Loc User}"/>
                    <ComboBoxItem Content="{Loc Guest}"/>
                </ComboBox>

                <Label Left="30" Top="386" Width="140" Height="20"
                       Text="{Loc Protocol:}" Foreground="#BAC2DE"/>
                <ComboBox Name="ddProtocol" Left="30" Top="408" Width="460" Height="32"
                          Items="RDP,VNC,SSH,HTTP,HTTPS" SelectedIndex="0"/>

                <!-- Секция: Кнопки -->
                <Label Left="30" Top="466" Width="200" Height="20"
                       Text="Button" Foreground="#89B4FA"/>
                <Separator Left="30" Top="490" Width="460" Height="1" Background="#313244"/>

                <Button Name="btnAccent" Left="30" Top="504" Width="140" Height="40"
                        Content="{Loc Sign in}" Style="Accent"
                        HoverBG="#1A8CFF" PressedBG="#005A9E"/>

                <Button Name="btnDefault" Left="186" Top="504" Width="140" Height="40"
                        Content="{Loc Cancel}"
                        HoverBG="#3A3A52" PressedBG="#2A2A3E"/>

                <Button Name="btnDanger" Left="342" Top="504" Width="148" Height="40"
                        Content="{Loc Delete}" Background="#C42B1C" Foreground="White"
                        HoverBG="#E03524" PressedBG="#A01E14"
                        BorderBrush="#E03524"/>

                <Button Name="btnDisabled" Left="30" Top="558" Width="220" Height="36"
                        Content="{Loc Reset the form}"
                        HoverBG="#3A3A52"/>

                <Button Name="btnExport" Left="266" Top="558" Width="224" Height="36"
                        Content="{Loc Export settings}" Style="Accent"
                        HoverBG="#1A8CFF"/>

                <!-- ──── Правая колонка: Текст с переносом ──────────────── -->
                <Label Left="540" Top="20" Width="200" Height="20"
                       Text="Label / TextBlock" Foreground="#89B4FA"/>
                <Separator Left="540" Top="44" Width="480" Height="1" Background="#313244"/>

                <Label Left="540" Top="56" Width="480" Height="20"
                       Text="{Loc Plain text (single line)}" Foreground="#CDD6F4"/>

                <Label Left="540" Top="88" Width="480" Height="100"
                       Text="{Loc A long text with word wrapping (TextWrapping=Wrap). The headless-gui engine wraps words pixel-precisely to the container width. That makes it possible to build information panels and dialogs with dynamic content.}"
                       Foreground="#A6ADC8" TextWrapping="Wrap" Background="#181828"/>

                <Label Left="540" Top="204" Width="480" Height="60"
                       Text="{Loc Another block of text. Default font, light background for contrast. A wrapping check at various sizes.}"
                       Foreground="#1E1E32" TextWrapping="Wrap" Background="#CDD6F4"/>

                <!-- Image -->
                <Label Left="540" Top="280" Width="200" Height="20"
                       Text="Image" Foreground="#89B4FA"/>
                <Separator Left="540" Top="304" Width="480" Height="1" Background="#313244"/>

                <Panel Left="540" Top="316" Width="480" Height="240" Background="#11112A"
                       CornerRadius="6" BorderBrush="#313244">
                    <Label Left="12" Top="12" Width="456" Height="216"
                           Text="{Loc [ Image area — Image Source='path' ]}"
                           Foreground="#585B70" TextWrapping="Wrap"/>
                </Panel>

                <!-- PopupMenu -->
                <Label Left="540" Top="466" Width="200" Height="20"
                       Text="PopupMenu / ContextMenu" Foreground="#89B4FA"/>
                <Separator Left="540" Top="490" Width="480" Height="1" Background="#313244"/>

                <Button Name="btnShowPopup" Left="540" Top="504" Width="220" Height="36"
                        Content="{Loc Show menu}" Style="Accent"
                        HoverBG="#1A8CFF"/>
                <Button Name="btnShowPopup2" Left="776" Top="504" Width="244" Height="36"
                        Content="{Loc Context menu (right click)}"
                        HoverBG="#3A3A52"/>

                <PopupMenu Name="ctxMenu">
                    <MenuItem Text="{Loc Copy}"/>
                    <MenuItem Text="{Loc Paste}"/>
                    <MenuItem Text="{Loc Cut}"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Text="{Loc Select all}"/>
                    <MenuItem Separator="True"/>
                    <MenuItem Text="{Loc Disabled}" Disabled="True"/>
                    <MenuItem Text="{Loc Delete}" />
                </PopupMenu>

                <!-- Separator demo -->
                <Label Left="540" Top="556" Width="200" Height="20"
                       Text="Separator" Foreground="#89B4FA"/>
                <Separator Left="540" Top="580" Width="480" Height="1" Background="#F38BA8"/>
                <Separator Left="540" Top="592" Width="480" Height="2" Background="#89B4FA"/>
                <Separator Left="540" Top="606" Width="480" Height="1" Background="#A6E3A1"/>
                <Separator Left="540" Top="620" Width="480" Height="3" Background="#F9E2AF"/>

            </Canvas>
        </TabItem>

        <!-- ─── TAB 2: Элементы управления ──────────────────────────────── -->
        <TabItem Header="{Loc Controls}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">

                <!-- CheckBox -->
                <Label Left="30" Top="20" Width="200" Height="20"
                       Text="CheckBox" Foreground="#89B4FA"/>
                <Separator Left="30" Top="44" Width="460" Height="1" Background="#313244"/>

                <CheckBox Name="cbRemember" Left="30" Top="58" Width="460" Height="28"
                          Content="{Loc Remember credentials}" IsChecked="true"/>
                <CheckBox Name="cbAutoConnect" Left="30" Top="92" Width="460" Height="28"
                          Content="{Loc Connect automatically on start}"/>
                <CheckBox Name="cbVerbose" Left="30" Top="126" Width="460" Height="28"
                          Content="{Loc Verbose logging}"/>
                <CheckBox Name="cbCompress" Left="30" Top="160" Width="460" Height="28"
                          Content="{Loc Compress transferred data}" IsChecked="true"/>

                <!-- RadioButton -->
                <Label Left="30" Top="210" Width="200" Height="20"
                       Text="RadioButton" Foreground="#89B4FA"/>
                <Separator Left="30" Top="234" Width="460" Height="1" Background="#313244"/>

                <Label Left="30" Top="248" Width="200" Height="20"
                       Text="{Loc Authentication method:}" Foreground="#BAC2DE"/>
                <RadioButton Name="rbLDAP" Left="30" Top="274" Width="460" Height="26"
                             Content="LDAP / Active Directory" GroupName="auth" IsChecked="true"/>
                <RadioButton Name="rbOTP" Left="30" Top="306" Width="460" Height="26"
                             Content="{Loc One-time password (OTP)}" GroupName="auth"/>
                <RadioButton Name="rbCert" Left="30" Top="338" Width="460" Height="26"
                             Content="{Loc Certificate (X.509)}" GroupName="auth"/>

                <Label Left="30" Top="382" Width="200" Height="20"
                       Text="{Loc Image quality:}" Foreground="#BAC2DE"/>
                <RadioButton Name="rbHigh" Left="30" Top="408" Width="220" Height="26"
                             Content="{Loc High}" GroupName="quality" IsChecked="true"/>
                <RadioButton Name="rbMedium" Left="250" Top="408" Width="220" Height="26"
                             Content="{Loc Medium}" GroupName="quality"/>
                <RadioButton Name="rbLow" Left="30" Top="440" Width="220" Height="26"
                             Content="{Loc Low}" GroupName="quality"/>

                <!-- ToggleSwitch -->
                <Label Left="30" Top="492" Width="200" Height="20"
                       Text="ToggleSwitch" Foreground="#89B4FA"/>
                <Separator Left="30" Top="516" Width="460" Height="1" Background="#313244"/>

                <ToggleSwitch Name="tsAutoRefresh" Left="30" Top="530" Width="460" Height="28"
                              Content="{Loc Auto-update}" IsOn="true"/>
                <ToggleSwitch Name="tsNotify" Left="30" Top="566" Width="460" Height="28"
                              Content="{Loc Notifications}"/>
                <ToggleSwitch Name="tsDarkMode" Left="30" Top="602" Width="460" Height="28"
                              Content="{Loc Dark theme}" IsOn="true"/>
                <ToggleSwitch Name="tsFullscreen" Left="30" Top="638" Width="460" Height="28"
                              Content="{Loc Full screen}"/>

                <!-- ──── Правая колонка: Slider ────────────────────────── -->
                <Label Left="540" Top="20" Width="200" Height="20"
                       Text="Slider" Foreground="#89B4FA"/>
                <Separator Left="540" Top="44" Width="480" Height="1" Background="#313244"/>

                <Label Left="540" Top="58" Width="200" Height="20"
                       Text="{Loc Speed (FPS):}" Foreground="#BAC2DE"/>
                <Slider Name="sliderSpeed" Left="540" Top="84" Width="400" Height="28"
                        Minimum="1" Maximum="60" Value="30"/>
                <Label Name="lblSpeedVal" Left="950" Top="84" Width="70" Height="20"
                       Text="30 FPS" Foreground="#A6E3A1"/>

                <Label Left="540" Top="124" Width="200" Height="20"
                       Text="{Loc Quality (%):}" Foreground="#BAC2DE"/>
                <Slider Name="sliderQuality" Left="540" Top="150" Width="400" Height="28"
                        Minimum="10" Maximum="100" Value="80"/>
                <Label Name="lblQualityVal" Left="950" Top="150" Width="70" Height="20"
                       Text="80%" Foreground="#F9E2AF"/>

                <Label Left="540" Top="190" Width="200" Height="20"
                       Text="{Loc Volume:}" Foreground="#BAC2DE"/>
                <Slider Name="sliderVolume" Left="540" Top="216" Width="400" Height="28"
                        Minimum="0" Maximum="100" Value="65"/>
                <Label Name="lblVolumeVal" Left="950" Top="216" Width="70" Height="20"
                       Text="65" Foreground="#89B4FA"/>

                <!-- ProgressBar -->
                <Label Left="540" Top="274" Width="200" Height="20"
                       Text="ProgressBar" Foreground="#89B4FA"/>
                <Separator Left="540" Top="298" Width="480" Height="1" Background="#313244"/>

                <Label Left="540" Top="312" Width="200" Height="20"
                       Text="{Loc Loading data:}" Foreground="#BAC2DE"/>
                <ProgressBar Name="pbMain" Left="540" Top="338" Width="400" Height="18"
                             Value="0.65"/>
                <Label Name="lblPbVal" Left="950" Top="336" Width="70" Height="20"
                       Text="65%" Foreground="#CDD6F4"/>

                <Label Left="540" Top="370" Width="200" Height="20"
                       Text="{Loc Installing updates:}" Foreground="#BAC2DE"/>
                <ProgressBar Name="pbSecondary" Left="540" Top="396" Width="400" Height="18"
                             Value="0.33" Foreground="#A6E3A1"/>
                <Label Name="lblPb2Val" Left="950" Top="394" Width="70" Height="20"
                       Text="33%" Foreground="#CDD6F4"/>

                <Label Left="540" Top="428" Width="200" Height="20"
                       Text="{Loc Backup:}" Foreground="#BAC2DE"/>
                <ProgressBar Name="pbTertiary" Left="540" Top="454" Width="400" Height="18"
                             Value="0.88" Foreground="#F38BA8"/>
                <Label Name="lblPb3Val" Left="950" Top="452" Width="70" Height="20"
                       Text="88%" Foreground="#CDD6F4"/>

                <!-- ScrollViewer -->
                <Label Left="540" Top="500" Width="200" Height="20"
                       Text="ScrollViewer" Foreground="#89B4FA"/>
                <Separator Left="540" Top="524" Width="480" Height="1" Background="#313244"/>

                <ScrollViewer Name="scrollDemo" Left="540" Top="538" Width="480" Height="200"
                              ContentHeight="500" Background="#181828">
                    <Label Left="12" Top="8" Width="440" Height="480"
                           Text="{Loc This is the content of a ScrollViewer. Scroll down to see the whole text. The scroller supports the mouse wheel and dragging the scrollbar. The content height is set through ContentHeight and can exceed the visible area. That makes it possible to place long lists, logs, documentation and any other content of arbitrary length inside a limited area of the screen. The widget works like the WPF ScrollViewer.}"
                           Foreground="#A6ADC8" TextWrapping="Wrap"/>
                </ScrollViewer>

            </Canvas>
        </TabItem>

        <!-- ─── TAB 3: Данные и контейнеры ──────────────────────────────── -->
        <TabItem Header="{Loc Data}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">

                <!-- ListView -->
                <Label Left="30" Top="20" Width="200" Height="20"
                       Text="ListView / ListBox" Foreground="#89B4FA"/>
                <Separator Left="30" Top="44" Width="460" Height="1" Background="#313244"/>

                <ListView Name="eventLog" Left="30" Top="58" Width="460" Height="300">
                    <ListViewItem Content="{Loc [09:00:01] Engine started}"/>
                    <ListViewItem Content="{Loc [09:00:01] XAML loaded: showcase.xaml}"/>
                    <ListViewItem Content="{Loc [09:00:02] Connecting to the server...}"/>
                    <ListViewItem Content="{Loc [09:00:03] Connection established}"/>
                    <ListViewItem Content="{Loc [09:00:03] Authentication: LDAP}"/>
                    <ListViewItem Content="{Loc [09:00:04] Session opened}"/>
                    <ListViewItem Content="{Loc [09:00:05] Loading the user profile}"/>
                    <ListViewItem Content="{Loc [09:00:06] Profile loaded}"/>
                    <ListViewItem Content="{Loc [09:00:07] Initialising the desktop}"/>
                    <ListViewItem Content="{Loc [09:00:08] Ready}"/>
                </ListView>

                <Button Name="btnAddEvent" Left="30" Top="370" Width="224" Height="36"
                        Content="{Loc Add record}" Style="Accent"
                        HoverBG="#1A8CFF"/>
                <Button Name="btnClearLog" Left="266" Top="370" Width="224" Height="36"
                        Content="{Loc Clear the log}"
                        HoverBG="#3A3A52"/>

                <!-- Grid layout demo -->
                <Label Left="30" Top="430" Width="200" Height="20"
                       Text="Grid Layout" Foreground="#89B4FA"/>
                <Separator Left="30" Top="454" Width="460" Height="1" Background="#313244"/>

                <Grid Name="demoGrid" Left="30" Top="468" Width="460" Height="280"
                      Background="#181828" ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Header row -->
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Loc Grid 4×3 (Grid with ShowGridLines)}"
                           Foreground="White" Background="#0078D4"/>

                    <!-- Content cells -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Loc Cell (1,0)}" Foreground="#BAC2DE" Background="#1E1E38"/>
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Loc Cell (1,1)}" Foreground="#BAC2DE" Background="#222240"/>
                    <Label Grid.Row="1" Grid.Column="2"
                           Text="(1,2)" Foreground="#BAC2DE" Background="#1E1E38"/>

                    <Label Grid.Row="2" Grid.Column="0"
                           Text="Star *" Foreground="#A6E3A1" Background="#222240"/>
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="Star *" Foreground="#F9E2AF" Background="#1E1E38"/>
                    <Label Grid.Row="2" Grid.Column="2"
                           Text="120px" Foreground="#F38BA8" Background="#222240"/>

                    <!-- Footer row -->
                    <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="{Loc Button in a Grid (ColumnSpan=2)}" Style="Accent"/>
                    <Button Grid.Row="3" Grid.Column="2"
                            Content="OK" HoverBG="#3A3A52"/>
                </Grid>

                <!-- ──── Правая колонка: TabControl вложенный ──────────── -->
                <Label Left="540" Top="20" Width="200" Height="20"
                       Text="{Loc TabControl (nested)}" Foreground="#89B4FA"/>
                <Separator Left="540" Top="44" Width="480" Height="1" Background="#313244"/>

                <TabControl Name="innerTabs" Left="540" Top="58" Width="480" Height="300">
                    <TabItem Header="{Loc Server}">
                        <Canvas Width="480" Height="250" Background="#181828">
                            <Label Left="16" Top="16" Width="448" Height="20"
                                   Text="{Loc Server settings}" Foreground="#CDD6F4"/>
                            <Separator Left="16" Top="40" Width="448" Height="1" Background="#313244"/>
                            <Label Left="16" Top="56" Width="120" Height="20"
                                   Text="{Loc Address:}" Foreground="#BAC2DE"/>
                            <TextBox Name="txtServer" Left="16" Top="78" Width="448" Height="32"
                                     Text="192.168.1.100" Placeholder="{Loc IP address or host name}"/>
                            <Label Left="16" Top="122" Width="120" Height="20"
                                   Text="{Loc Port:}" Foreground="#BAC2DE"/>
                            <TextBox Name="txtPort" Left="16" Top="144" Width="200" Height="32"
                                     Text="3389" Placeholder="{Loc Port number}"/>
                            <CheckBox Name="cbSSL" Left="16" Top="192" Width="448" Height="26"
                                      Content="{Loc Use SSL/TLS}" IsChecked="true"/>
                        </Canvas>
                    </TabItem>
                    <TabItem Header="{Loc Display}">
                        <Canvas Width="480" Height="250" Background="#181828">
