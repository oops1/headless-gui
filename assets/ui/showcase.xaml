                           Text="{Loc The animation clock belongs to the engine: not a single goroutine and not a single timer per animation — ticks come from the render loop, frames are rendered only while an animation is alive (the on-demand saving stays), and repainting is partial. Starting an animation again on the same object replaces the previous one (owner-replace), so animations never fight. The toggles on the Widgets tab slide, dialogs fade in; in the classic Win2000 theme everything is instant.}"/>
            </Canvas>
        </TabItem>

        <TabItem Header="{Loc Dialogs}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">
                <TextBlock Left="24" Top="16" Style="{StaticResource H324}"
                           Text="{Loc Standard dialogs (theme · localisation · Ctrl+C · Enter/Esc)}"/>
                <Separator Left="24" Top="40" Width="1010" Height="1" Background="#313244"/>

                <TextBlock Left="24" Top="58" Foreground="#9399B2"
                           Text="{Loc MessageBox (severity icon, Ctrl+C copies as on Windows):}"/>
                <Button Name="dlgInfo" Left="24" Top="82" Width="150" Height="34" Content="{Loc Information}"/>
                <Button Name="dlgQuestion" Left="184" Top="82" Width="150" Height="34" Content="{Loc Question (Yes/No)}"/>
                <Button Name="dlgWarn" Left="344" Top="82" Width="150" Height="34" Content="{Loc Warning}"/>
                <Button Name="dlgError" Left="504" Top="82" Width="150" Height="34" Content="{Loc Error}" Style="Accent"/>

                <TextBlock Left="24" Top="140" Foreground="#9399B2" Text="{Loc Input and progress:}"/>
                <Button Name="dlgInput" Left="24" Top="164" Width="180" Height="34" Content="{Loc Text input}"/>
                <Button Name="dlgProgress" Left="214" Top="164" Width="220" Height="34" Content="{Loc Progress (indicator)}"/>
                <Button Name="dlgBig" Left="444" Top="164" Width="220" Height="34" Content="{Loc Dialog larger than the window}"/>

                <TextBlock Left="24" Top="222" Foreground="#9399B2" Text="{Loc File dialogs (the file system of this process):}"/>
                <Button Name="dlgOpen" Left="24" Top="246" Width="180" Height="34" Content="{Loc Open file…}"/>
                <Button Name="dlgSave" Left="214" Top="246" Width="180" Height="34" Content="{Loc Save as…}"/>
                <Button Name="dlgFolder" Left="404" Top="246" Width="180" Height="34" Content="{Loc Select folder…}"/>

                <Label Name="dlgResult" Left="24" Top="310" Width="1010" Height="24"
                       Text="{Loc The result will appear here}" Foreground="#A6E3A1"/>

                <TextBlock Left="24" Top="360" Width="1010" Height="60" TextWrapping="Wrap"
                           Foreground="#6C7086"
                           Text="{Loc Every dialog is internal (the engine draws it over the dimmed background), so dialogs work headless and in streaming, and file dialogs show the server file system. The look follows the application theme (try switching the theme in the header) and the labels are localised (the Language button in the header switches RU/EN live). In a MessageBox: Enter — default button, Esc — cancel, Ctrl+C — copy the contents.}"/>

                <TextBlock Left="24" Top="430" Style="{StaticResource H324}"
                           Text="{Loc Multiline TextBox}"/>
                <TextBox Name="editBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Left="24" Top="460" Width="500" Height="180"
                         Tag="Введите многострочный текст…"/>
                <TextBox Name="editBoxRO" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                         Left="540" Top="460" Width="320" Height="180"/>
                <Label Name="editStats" Left="24" Top="646" Width="700" Height="20"
                       Text="" Foreground="#6C7086"/>
            </Canvas>
        </TabItem>

        <TabItem Header="{Loc Layout}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">
                <TextBlock Left="24" Top="16" Style="{StaticResource H324}"
                           Text="{Loc SplitPanel — panes with a draggable splitter}"/>
                <Separator Left="24" Top="40" Width="1010" Height="1" Background="#313244"/>
                <TextBlock Left="24" Top="52" Foreground="#9399B2"
                           Text="{Loc Drag the bars with the mouse (the cursor changes), double click a bar to collapse or restore it. On the left there is a nested vertical split.}"/>

                <SplitPanel Name="splitOuter" Left="24" Top="84" Width="1010" Height="380"
                            Orientation="Horizontal" Position="0.35" MinFirst="120" MinSecond="240">
                    <SplitPanel Name="splitInner" Orientation="Vertical" Position="0.5"
                                MinFirst="60" MinSecond="60">
                        <Canvas Background="#28283E">
                            <Label Left="12" Top="10" Width="200" Height="18" Text="{Loc A (nested top)}" Foreground="#89B4FA"/>
                        </Canvas>
                        <Canvas Background="#232338">
                            <Label Left="12" Top="10" Width="200" Height="18" Text="{Loc B (nested bottom)}" Foreground="#A6E3A1"/>
                        </Canvas>
                    </SplitPanel>
                    <Canvas Background="#2A2A40">
                        <Label Left="12" Top="10" Width="300" Height="18" Text="{Loc C (right panel)}" Foreground="#F9E2AF"/>
                        <Label Name="splitPosLbl" Left="12" Top="34" Width="300" Height="18" Text="Position: 0.35" Foreground="#9399B2"/>
                    </Canvas>
                </SplitPanel>

                <Button Name="splitCollapse" Left="24" Top="478" Width="240" Height="32"
                        Content="{Loc Collapse/restore the left pane}"/>

                <TextBlock Left="24" Top="530" Style="{StaticResource H324}"
                           Text="{Loc SVGIcon — themeable vector icons}"/>
                <Separator Left="24" Top="554" Width="1010" Height="1" Background="#313244"/>
                <TextBlock Left="24" Top="566" Foreground="#9399B2"
                           Text="{Loc Without Color the icon takes the theme text colour (switch the theme in the header); with Color it is fixed. Any size — it is a vector.}"/>

                <SVGIcon Left="24"  Top="596" Width="32" Height="32" Source="icons/menu.svg"/>
                <SVGIcon Left="72"  Top="596" Width="32" Height="32" Source="icons/close.svg"/>
                <SVGIcon Left="120" Top="596" Width="32" Height="32" Source="icons/folder.svg"/>
                <SVGIcon Left="184" Top="588" Width="48" Height="48" Source="icons/folder.svg" Color="#F9E2AF"/>
                <SVGIcon Left="248" Top="580" Width="64" Height="64" Source="icons/menu.svg" Color="#89B4FA"/>
                <SVGIcon Left="330" Top="572" Width="80" Height="80" Source="icons/close.svg" Color="#F38BA8"/>
            </Canvas>
        </TabItem>

        <TabItem Header="{Loc Docking}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">
                <TextBlock Left="24" Top="16" Style="{StaticResource H324}"
                           Text="{Loc DockManager — docking panels (Visual Studio style toolbox)}"/>
                <Separator Left="24" Top="40" Width="1010" Height="1" Background="#313244"/>
                <TextBlock Left="24" Top="52" Width="1010" Foreground="#9399B2"
                           Text="{Loc Drag a panel by its title bar — the dock guides appear; 📌 collapses the panel into a tab at the edge (auto-hide); the window button makes the panel floating.}"/>

                <DockManager Name="dockDemo" Left="24" Top="84" Width="1010" Height="560" Background="#232338" NativeFloating="True">
                    <DockPane Id="dockTools" Title="{Loc Explorer}" Side="Left" Size="220" State="Docked">
                        <ListView>
                            <ListViewItem Content="{Loc Report.docx}"/>
                            <ListViewItem Content="{Loc Budget.xlsx}"/>
                            <ListViewItem Content="{Loc Archive}"/>
                            <ListViewItem Content="{Loc Notes.txt}"/>
                        </ListView>
                    </DockPane>

                    <DockPane Id="dockProps" Title="{Loc Properties}" Side="Right" Size="200" State="Docked">
                        <StackPanel Orientation="Vertical" Padding="8" Spacing="6">
                            <Label Text="{Loc Name: Report.docx}" Foreground="#CDD6F4"/>
                            <Label Text="{Loc Size: 128 KB}" Foreground="#9399B2"/>
                        </StackPanel>
                    </DockPane>

                    <DockPane Id="dockOutput" Title="{Loc Output}" Side="Bottom" Size="120" State="Docked">
                        <TextBlock Text="{Loc Done. The layout can be saved and restored with the buttons below.}"
                                   Foreground="#A6E3A1" TextWrapping="Wrap"/>
                    </DockPane>

                    <DockContent>
                        <TextBox Name="dockCenterText" AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Loc The document area is the centre of the DockManager (SetCenter). An editor or a document viewer usually lives here.}"/>
                    </DockContent>
                </DockManager>

                <Button Name="dockSaveLayout" Left="24" Top="654" Width="220" Height="32" Content="{Loc Save layout}"/>
                <Button Name="dockRestoreLayout" Left="254" Top="654" Width="220" Height="32" Content="{Loc Restore layout}"/>
                <TextBlock Name="dockLayoutStatus" Left="490" Top="662" Width="544" Foreground="#9399B2" Text=""/>
            </Canvas>
        </TabItem>

        <TabItem Header="{Loc Tabbed window}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">
                <TextBlock Left="24" Top="16" Style="{StaticResource H324}"
                           Text="{Loc Window with tabs in the title bar (Windows 11 Terminal style)}"/>
                <Separator Left="24" Top="40" Width="1010" Height="1" Background="#313244"/>
                <TextBlock Left="24" Top="54" Width="1010" Height="36" TextWrapping="Wrap" Foreground="#9399B2"
                           Text="{Loc Tabs live in the window title bar next to the window buttons: a cross closes a tab, plus opens a new one, the chevron shows the profile menu. Free title-bar space still drags the window. Switch the theme - the tab strip follows Win10/Win11, Win2000 bevel and Mac styles.}"/>
                <Panel Name="tabWinMount" Left="24" Top="100" Width="1010" Height="580" Background="#161622"/>
                <TextBlock Left="24" Top="694" Width="1010" Height="40" TextWrapping="Wrap" Foreground="#6C7086"
                           Text="{Loc The inner window is a real widget.Window with EnableTitleTabs: drag it by the title, resize by the edges, close all tabs - OnClose restores the demo.}"/>
            </Canvas>
        </TabItem>

        <TabItem Header="{Loc System}">
            <Canvas Width="1060" Height="770" Background="#1E1E32">
                <TextBlock Left="24" Top="16" Style="{StaticResource H324}"
                           Text="{Loc Tray · notifications · window preview (Windows only)}"/>
                <Separator Left="24" Top="40" Width="1010" Height="1" Background="#313244"/>

                <TextBlock Left="24" Top="58" Foreground="#9399B2"
                           Text="{Loc Balloon notifications (system, Shell_NotifyIcon · NIF_INFO):}"/>
                <Button Name="sysBalloonInfo" Left="24" Top="82" Width="180" Height="34" Content="{Loc Balloon: info}"/>
                <Button Name="sysBalloonWarn" Left="214" Top="82" Width="200" Height="34" Content="{Loc Balloon: warning}"/>
                <Button Name="sysBalloonErr" Left="424" Top="82" Width="180" Height="34" Content="{Loc Balloon: error}" Style="Accent"/>

                <TextBlock Left="24" Top="140" Foreground="#9399B2"
                           Text="{Loc Window and tray:}"/>
                <Button Name="sysHide" Left="24" Top="164" Width="220" Height="34" Content="{Loc Minimise to tray}"/>
                <TextBlock Left="256" Top="172" Foreground="#6C7086"
                           Text="{Loc The icon stays in the tray: double left click restores the window, right click opens the menu.}"/>

                <TextBlock Left="24" Top="222" Foreground="#9399B2"
                           Text="{Loc Taskbar preview:}"/>
                <TextBlock Left="24" Top="246" Width="1010" Height="40" TextWrapping="Wrap"
                           Foreground="#A6E3A1"
                           Text="{Loc Hover the application button on the taskbar — the thumbnail and Aero Peek show the live window content (not a black rectangle).}"/>

                <TextBlock Left="24" Top="316" Foreground="#9399B2"
                           Text="{Loc Drag and drop files from the OS (drag files from the file manager into the frame):}"/>
                <Border Name="dropZone" Left="24" Top="340" Width="1010" Height="130"
                        Background="#232338" BorderBrush="#45475A" BorderThickness="2"
                        CornerRadius="8">
                    <Label Name="dropLabel" Left="16" Top="52" Width="978" Height="24"
                           Text="{Loc Drop files here — their paths will appear}"
                           Foreground="#6C7086"/>
                </Border>

                <TextBlock Left="24" Top="486" Width="1010" Height="80" TextWrapping="Wrap"
                           Foreground="#6C7086"
                           Text="{Loc The tray icon is installed at startup (a blue square with a white G). The tray menu (right click): Show / Minimise / Balloon / Exit — it renders in its own popup window at the cursor, so it appears even when the main window is hidden. Drag and drop: native on Win32 and X11, a skeleton on Wayland. On platforms without tray or balloon support — polite no-ops.}"/>
            </Canvas>
        </TabItem>

    </TabControl>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STATUS BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Статус-бар прижат к низу на всю ширину (Left+Right=0, Bottom=0). Левая
         подпись — внутри панели; прогресс и FPS вынесены прямыми детьми Canvas
         и прижаты к правому-нижнему краю (панель не двигает своих детей). -->
    <Panel Name="statusBar" Left="0" Right="0" Bottom="0" Height="36"
           Background="#11111B"/>
    <Label Name="lblStatus" Left="16" Bottom="8" Width="600" Height="20"
           Text="{Loc Ready · Widget Showcase · headless-gui}" Foreground="#6C7086"/>
    <ProgressBar Name="pbStatus" Right="180" Bottom="12" Width="300" Height="12"
                 Value="1.0" Foreground="#0078D4"/>
    <Label Name="lblFPS" Right="20" Bottom="8" Width="140" Height="20"
           Text="60 FPS" Foreground="#585B70"/>

</Canvas>
</Window>
