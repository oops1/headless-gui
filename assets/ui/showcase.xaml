<?xml version="1.0" encoding="UTF-8"?>
<!--
    GuiEngine — Widget Showcase
    Демонстрация ВСЕХ доступных виджетов движка.
    WPF-совместимый XAML.
-->
<Canvas Name="root" Width="1280" Height="900" Background="#0D0D1A">

    <!-- Ресурсы и горячие клавиши для вкладки «3.2.4» (новый функционал) -->
    <Canvas.Resources>
        <SolidColorBrush x:Key="Accent324" Color="#0E639C"/>
        <Style x:Key="H324" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Status324" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6E3A1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERROR">
                    <Setter Property="Foreground" Value="#F38BA8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="Card324">
            <Border Background="{TemplateBinding Background}" BorderBrush="#5A5A6A" BorderThickness="1">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </Canvas.Resources>
    <Canvas.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
    </Canvas.InputBindings>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <Panel Name="header" Left="0" Top="0" Width="1280" Height="52"
           Background="#0078D4">
        <Label Name="headerTitle" Left="20" Top="14" Width="500" Height="24"
               Text="GuiEngine — Widget Showcase" Foreground="White"/>
        <ComboBox Name="themeSelect" Left="690" Top="10" Width="235" Height="32"
                  Items="Win10 Dark,Win10 Light,Win11 Dark,Win11 Light,Win2000,Mac"
                  SelectedIndex="0" ToolTip="Сменить тему оформления"/>
        <Button Name="langToggle" Left="940" Top="10" Width="120" Height="32"
                Content="Язык: RU" Background="#005A9E" Foreground="White"
                HoverBG="#1A8CFF" PressedBG="#004578" BorderBrush="#1A8CFF"
                ToolTip="Переключить язык интерфейса / Switch UI language"/>
        <Label Name="headerClock" Left="1090" Top="14" Width="180" Height="24"
               Text="00:00:00" Foreground="#B0D4FF"/>
    </Panel>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MENU BAR — горизонтальное меню
         ═══════════════════════════════════════════════════════════════════════ -->
    <Menu Name="mainMenu" Left="0" Top="52" Width="1280" Height="28">
        <MenuItem Header="Файл">
            <MenuItem Text="Новый"/>
            <MenuItem Text="Открыть"/>
            <MenuItem Text="Сохранить"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Экспорт..."/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Выход"/>
        </MenuItem>
        <MenuItem Header="Правка">
            <MenuItem Text="Отменить"/>
            <MenuItem Text="Повторить"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Вырезать"/>
            <MenuItem Text="Копировать"/>
            <MenuItem Text="Вставить"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Выделить всё"/>
        </MenuItem>
        <MenuItem Header="Вид">
            <MenuItem Text="Панель инструментов"/>
            <MenuItem Text="Строка состояния"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Масштаб 100%"/>
            <MenuItem Text="Масштаб 150%"/>
        </MenuItem>
        <MenuItem Header="Подключение">
            <MenuItem Text="Новое подключение"/>
            <MenuItem Text="Быстрое подключение"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="Отключить"/>
        </MenuItem>
        <MenuItem Header="Справка">
            <MenuItem Text="Документация"/>
            <MenuItem Text="Горячие клавиши"/>
            <MenuItem Separator="True"/>
            <MenuItem Text="О программе"/>
        </MenuItem>
    </Menu>

